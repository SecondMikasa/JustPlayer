+  // ==================== MUSIC LIBRARY ====================
+  // NOTE: albums/artists are grouped in-memory from getAllSongs() for simplicity.
+  // Fine for typical libraries (hundreds-low thousands of tracks); if this becomes
+  // a bottleneck on very large libraries, replace with a proper SQL GROUP BY query
+  // (SELECT album, artist, albumId, COUNT(*) FROM hybrid_media_index WHERE isAudio = 1 ...)
+  // added directly to HybridMediaDao.
+
+  suspend fun getAllSongs(): List<Video> = withContext(Dispatchers.IO) {
+    dao.getAllAudio()
+      .asSequence()
+      .map { it.toVideo() }
+      .sortedBy { it.title.lowercase() }
+      .toList()
+  }
+
+  suspend fun getAlbums(): List<MusicAlbum> = withContext(Dispatchers.IO) {
+    getAllSongs()
+      .groupBy { it.albumId.takeIf { id -> id != 0L } ?: (it.album to it.artist).hashCode().toLong() }
+      .map { (albumKey, songs) ->
+        val sample = songs.first()
+        MusicAlbum(
+          id = albumKey,
+          title = sample.album.ifBlank { "Unknown Album" },
+          artist = sample.artist.ifBlank { "Unknown Artist" },
+          songCount = songs.size,
+          year = songs.maxOf { it.year },
+        )
+      }
+      .sortedBy { it.title.lowercase() }
+  }
+
+  suspend fun getArtists(): List<MusicArtist> = withContext(Dispatchers.IO) {
+    getAllSongs()
+      .groupBy { it.artist.ifBlank { "Unknown Artist" } }
+      .map { (artist, songs) ->
+        MusicArtist(
+          name = artist,
+          songCount = songs.size,
+          albumCount = songs.map { it.albumId.takeIf { id -> id != 0L } ?: (it.album to it.artist).hashCode().toLong() }.distinct().size,
+        )
+      }
+      .sortedBy { it.name.lowercase() }
+  }
+
+  suspend fun getSongsForAlbum(albumId: Long): List<Video> = withContext(Dispatchers.IO) {
+    getAllSongs()
+      .filter { (it.albumId.takeIf { id -> id != 0L } ?: (it.album to it.artist).hashCode().toLong()) == albumId }
+      .sortedWith(compareBy({ it.trackNumber.takeIf { n -> n != 0 } ?: Int.MAX_VALUE }, { it.title.lowercase() }))
+  }
+
+  suspend fun getSongsForArtist(artist: String): List<Video> = withContext(Dispatchers.IO) {
+    getAllSongs().filter { it.artist.ifBlank { "Unknown Artist" } == artist }
+  }
+
