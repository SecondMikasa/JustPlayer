@@ -134,6 +134,18 @@ object PermissionUtils {
       else -> android.Manifest.permission.READ_EXTERNAL_STORAGE
     }
 
+  /**
+   * Returns the set of permissions needed for full media library access (video + audio).
+   * On Android 13+, video and audio are separate runtime permissions; below that, the
+   * single storage permission from [getStoragePermission] already covers both.
+   */
+  fun getMediaLibraryPermissions(): List<String> =
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+      listOf(android.Manifest.permission.READ_MEDIA_VIDEO, android.Manifest.permission.READ_MEDIA_AUDIO)
+    } else {
+      listOf(getStoragePermission())
+    }
+
   /**
    * Creates a permission state for storage access.
    */
@@ -141,6 +153,51 @@ object PermissionUtils {
   @Composable
   fun rememberStoragePermissionState(): PermissionState = rememberPermissionState(getStoragePermission())
 
+  /**
+   * Handles combined video+audio media permissions (e.g. for the Music library screen)
+   * and invokes [onPermissionGranted] once all required permissions are granted.
+   * Mirrors [handleStoragePermission]'s MANAGE_EXTERNAL_STORAGE fallback on Android 11+.
+   */
+  @OptIn(ExperimentalPermissionsApi::class)
+  @Composable
+  fun handleMediaLibraryPermissions(
+    onPermissionGranted: () -> Unit,
+  ): com.google.accompanist.permissions.MultiplePermissionsState {
+    val permissionsState = com.google.accompanist.permissions.rememberMultiplePermissionsState(
+      permissions = getMediaLibraryPermissions()
+    )
+    val context = LocalContext.current
+    var lifecycleTrigger by remember { mutableIntStateOf(0) }
+
+    DisposableEffect(Unit) {
+      val lifecycleOwner = context as? LifecycleOwner
+      val observer =
+        LifecycleEventObserver { _, event ->
+          if (event == Lifecycle.Event.ON_RESUME) {
+            lifecycleTrigger++
+          }
+        }
+      lifecycleOwner?.lifecycle?.addObserver(observer)
+      onDispose {
+        lifecycleOwner?.lifecycle?.removeObserver(observer)
+      }
+    }
+
+    val hasManageStorage = remember(lifecycleTrigger) {
+      !BuildConfig.SCOPED_STORAGE_ONLY &&
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.R &&
+        android.os.Environment.isExternalStorageManager()
+    }
+
+    LaunchedEffect(permissionsState.allPermissionsGranted, hasManageStorage) {
+      if (hasManageStorage || permissionsState.allPermissionsGranted) {
+        onPermissionGranted()
+      }
+    }
+
+    return permissionsState
+  }
+
   /**
    * Handles storage permission and invokes [onPermissionGranted] when granted.
    * On Android 11+, also checks MANAGE_EXTERNAL_STORAGE permission.
